# Sizing for the parallel k=40 FHE experiment (config/run_parallel.sh 40 16 4).
#
# VM.Standard.A1.Flex: $0.01/OCPU-hr + $0.0015/GB-hr => ~$0.83/hr at this size;
# the full experiment (provision + OpenFHE build + ~1.5h run) costs ~$3.
# 16 workers x 4 OMP threads = 64 OCPUs; each worker holds its own N=131072
# CKKS context (~6 GB peak) => 128 GB RAM.
#
# Usage: copy to parallel.tfvars (or merge into your terraform.tfvars), then
#   terraform apply -var-file=parallel.tfvars
# Scale back down (or destroy) after the run.

instance_ocpus     = 64
instance_memory_gb = 128
