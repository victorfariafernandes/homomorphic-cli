# Sizing for the parallel k=40 FHE experiment.
#
# VM.Standard.A1.Flex: $0.01/OCPU-hr + $0.0015/GB-hr => ~$0.83/hr at this size.
#
# MEASURED 2026-07-16: a security=128 worker (N=131072 context + rotation +
# bootstrap eval keys) peaks at ~24 GB RSS, not the ~6 GB first estimated.
# At 128 GB RAM the box fits only 4-5 workers => run `run_parallel.sh 40 4 16`
# (4 workers x 16 threads; ~9 min/solve, NTT scaling flattens past ~8 threads).
# For the full 16 workers x 4 threads geometry, provision instance_memory_gb=384.
#
# Usage: copy to parallel.tfvars (gitignored — never commit real credentials),
# fill in the OCI identifiers below, then
#   terraform apply -var-file=parallel.tfvars
# Scale back down (or destroy) after the run.

tenancy_ocid          = "ocid1.tenancy.oc1..REPLACE_ME"
user_ocid             = "ocid1.user.oc1..REPLACE_ME"
fingerprint           = "REPLACE_ME"
ssh_private_key_path  = "~/.ssh/REPLACE_ME"
region                = "us-ashburn-1"
compartment_id        = "ocid1.compartment.oc1..REPLACE_ME"
ssh_public_key        = "ssh-rsa REPLACE_ME"
ssh_deploy_public_key = "ssh-rsa REPLACE_ME"

instance_ocpus     = 72
instance_memory_gb = 470
